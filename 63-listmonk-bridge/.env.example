# Shared secret: every endpoint but /health needs header X-API-Key with this value.
# Same value as in 01-marketing-stack/.env.
INTERNAL_API_KEY=change-me
# Listmonk base URL (no /api). In the stack: http://listmonk:9000
LISTMONK_URL=http://localhost:9000
# Listmonk API user + token (Admin -> Users -> New, type "API"). Never logged or returned.
LISTMONK_USER=
LISTMONK_TOKEN=
# token = "Authorization: token user:token" (Listmonk v4+). basic = HTTP basic auth (older).
LISTMONK_AUTH_MODE=token
# Comma-separated list ids: the default audience AND the allowlist. Ids from GET /lists.
LISTMONK_LIST_IDS=
# Browser URL of Listmonk, used for the returned campaign link. Empty = LISTMONK_URL.
LISTMONK_PUBLIC_URL=http://localhost:9000
# Optional: From address and campaign template id. Empty = Listmonk's defaults.
LISTMONK_FROM_EMAIL=
LISTMONK_TEMPLATE_ID=
# true = validate only, never call Listmonk. Set to false to create real drafts.
DRY_RUN=true
# true = a request with send_at is also scheduled. Default false: a person presses send.
ALLOW_SCHEDULE=false
# Comma-separated addresses for POST /campaigns/{id}/test. Must exist as Listmonk subscribers.
TEST_EMAILS=
