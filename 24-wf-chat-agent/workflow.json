{
  "id": "mktWf24ChatAgent",
  "name": "24 · Marketing chat agent",
  "nodes": [
    {
      "id": "068d37f8-460d-5296-a7a2-1d4ad6e8a7b6",
      "name": "Chat",
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
        300
      ],
      "parameters": {
        "public": true,
        "mode": "hostedChat",
        "authentication": "n8nUserAuth",
        "initialMessages": "Hi! I'm your marketing agent, running on your local model.\nTry: \"Write an X and LinkedIn post about our new decaf, link https://example.com/decaf\" or \"What's in the content calendar?\"",
        "options": {
          "title": "Marketing agent",
          "subtitle": "Local LLM · drafts only, you approve",
          "inputPlaceholder": "Ask for a post, a brief, research…"
        }
      },
      "webhookId": "mkt-marketing-chat"
    },
    {
      "id": "b9be25cc-c6c8-5e42-bd16-4e0f21d8c7c7",
      "name": "Marketing agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        320,
        300
      ],
      "parameters": {
        "promptType": "auto",
        "options": {
          "systemMessage": "=You are the in-house marketing agent for the brand described in the knowledge base. Today is {{ $now.toFormat('cccc d LLLL yyyy') }}.\n\nHow you work:\n- For any writing task, CALL A TOOL. Never write marketing copy yourself: the tools apply the brand rules, platform limits and quality checks.\n  - blog article → write_blog_post\n  - social posts → write_social_posts (pass every channel the user names, comma-separated)\n  - search ads → write_ad_copy\n  - newsletter → write_email\n  - video script (Reels/TikTok/Shorts), landing page copy, or a multi-email nurture sequence → write_content_format\n  - SEO plan for a keyword → seo_brief; keyword ideas → keyword_research\n  - turn an article/page/text into posts → repurpose_content\n  - analyse a competitor or any web page → research_url\n  - \"is this copy ok?\" → check_copy\n  - questions about our products, policies, digests, competitors → ask_knowledge_base\n  - see or change planned content → content_calendar\n  - plan a new campaign (goal, dates, channels) → plan_campaign\n  - list campaigns, their scorecard/results, activate/pause/complete them, set targets → campaigns\n- After a tool returns, show the user its result (you may trim it). Keep calendar ids (#12) so they can refer to them.\n- Ask one short question only if a required detail is missing (e.g. no topic). Otherwise pick sensible defaults and go.\n- Never claim something was published. Content is published only after a human approves it in the approval form.\n- Do not invent facts, prices, statistics or customer names.",
          "maxIterations": 6
        }
      }
    },
    {
      "id": "7ca6e9f7-e2fb-5c39-b8e3-1368b9226401",
      "name": "Local model (Ollama)",
      "type": "@n8n/n8n-nodes-langchain.lmChatOllama",
      "typeVersion": 1,
      "position": [
        0,
        560
      ],
      "parameters": {
        "model": "mkt-agent:latest",
