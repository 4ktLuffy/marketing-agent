          }
        ]
      ]
    },
    "KPIs": {
      "main": [
        [
          {
            "node": "Highlights",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Highlights": {
      "main": [
        [
          {
            "node": "Render report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Render report": {
      "main": [
        [
          {
            "node": "Webhook set?",
            "type": "main",
            "index": 0
          },
          {
            "node": "Email set?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Webhook set?": {
      "main": [
        [
          {
            "node": "Notify",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Email set?": {
      "main": [
        [
          {
