    {
      "id": "bb7b9a5f-f79c-5f9e-83df-556a57a46812",
      "name": "Related searches",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "method": "POST",
