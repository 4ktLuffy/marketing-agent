# Shared secret for write endpoints (POST). Same value as in 01-marketing-stack/.env.
INTERNAL_API_KEY=change-me
# SQLite file; keep it on the /data volume.
DB_PATH=/data/voc.sqlite
# LLM gateway (03): themes, headlines and personas.
GATEWAY_URL=http://llm-gateway:8000
# Optional sources for POST /sources/pull: review-hub (58) and gsc-sync (67). Empty = skipped.
REVIEWS_URL=http://review-hub:8000
GSC_URL=http://gsc-sync:8000
# Embeddings for GET /relevant (keyword overlap when Ollama is down).
OLLAMA_URL=http://host.docker.internal:11434
EMBED_MODEL=qwen3-embedding:0.6b
