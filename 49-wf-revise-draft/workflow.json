      "parameters": {
        "jsCode": "function opsToItems(ops, base) {\n  if (!ops.length) return [{ json: { method: 'GET', url: `${base}/health`, body: '{}', noop: true } }];\n  return ops.map(o => ({ json: { ...o, body: JSON.stringify(o.body || {}) } }));\n}\n\nconst ops = $('Save ops').all().map(i => i.json).filter(o => o.stage === 2);\nreturn opsToItems(ops, $env.CALENDAR_URL);\n"
      }
    },
