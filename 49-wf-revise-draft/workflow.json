    },
    {
      "id": "96cbdb78-c978-52f9-9151-1ecbd93c78c7",
      "name": "Valid",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "jsCode": "return $input.all().filter(i => /^\\d+$/.test(String(i.json.item_id || '')));\n"
      }
    },
    {
      "id": "2f4e578c-b7d2-5bfd-a3d3-76d2020617d6",
      "name": "Item",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.CALENDAR_URL }}/items/{{ $json.item_id }}",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.INTERNAL_API_KEY }}"
            }
          ]
        }
      }
    },
    {
      "id": "2916624c-eb69-53fe-b6b3-91f4c59f24f7",
      "name": "Attempts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.LEARNING_URL }}/items/{{ $('Valid').item.json.item_id }}/attempts",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "cf21aae5-47b0-506f-a3ff-cbe44682e3d8",
      "name": "Decide",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        300
      ],
      "parameters": {
        "jsCode": "const MAX = 3;\nconst it = $('Item').item.json;\nconst n = $json.rejections ?? 1;\nreturn { json: { id: it.id, channel: it.channel, text: it.body, reason: $('Valid').item.json.reason || 'Make it clearer and more on-brand.',\n  attempt: n, give_up: n > MAX } };\n",
        "mode": "runOnceForEachItem"
      }
    },
    {
      "id": "23df8471-daa1-5efa-9e4a-caa034b5ec87",
      "name": "Within limit",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        300
      ],
      "parameters": {
        "jsCode": "return $input.all().filter(i => !i.json.give_up);\n"
      }
    },
    {
      "id": "24384725-38c0-59b1-81bc-0d1d04064b70",
      "name": "Revise",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.GATEWAY_URL }}/v1/run",
        "options": {
          "timeout": 300000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ prompt: 'revise_with_feedback', vars: { text: $json.text, reason: $json.reason, channel: $json.channel } }) }}"
      }
    },
    {
      "id": "9dbd531d-268e-54ba-bb20-346b5ef41ef5",
      "name": "Keep links",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        300
      ],
      "parameters": {
        "jsCode": "const d = $('Within limit').item.json;\nlet text = $json.output.text.trim();\n// The model has swapped links before; put back any URL from the rejected draft.\nfor (const url of (d.text.match(/https?:\\/\\/\\S+/g) || [])) if (!text.includes(url)) text += `\\n\\n${url}`;\nreturn { json: { ref: String(d.id), channel: d.channel, text, context: null } };\n",
        "mode": "runOnceForEachItem"
      }
    },
    {
      "id": "7bbb7339-e3c5-5165-abf1-b09435b09ff2",
      "name": "Quality gate",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        1920,
        300
      ],
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "mktWf35QualityGa"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "text": "={{ $json.text }}",
            "channel": "={{ $json.channel }}",
            "context": "",
            "ref": "={{ $json.ref }}"
          },
          "matchingColumns": [],
          "schema": [
            {
              "id": "text",
              "displayName": "text",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true,
              "type": "string",
              "removed": false
            },
            {
              "id": "channel",
              "displayName": "channel",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true,
              "type": "string",
              "removed": false
            },
            {
              "id": "context",
              "displayName": "context",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true,
              "type": "string",
              "removed": false
            },
            {
              "id": "ref",
              "displayName": "ref",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true,
              "type": "string",
              "removed": false
            }
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "mode": "once",
        "options": {
          "waitForSubWorkflow": true
        }
      }
    },
    {
      "id": "e14086d1-b606-5ed3-8bd0-29ebddb197ed",
      "name": "Save ops",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2160,
        300
      ],
      "parameters": {
        "jsCode": "function rawOps(ops) { return ops.length ? ops.map(o => ({ json: o })) : [{ json: { stage: 0 } }]; }\n\nconst base = $env.CALENDAR_URL;\nconst attempts = Object.fromEntries($('Within limit').all().map(i => [String(i.json.id), i.json]));\nconst notesOf = Object.fromEntries($('Item').all().map(i => [String(i.json.id), i.json.notes || '']));\nconst ops = [];\nfor (const r of $input.all().map(i => i.json)) {\n  const a = attempts[r.ref];\n  ops.push({ stage: 1, method: 'PATCH', url: `${base}/items/${r.ref}`, body: { body: r.text } });\n  if (r.ok) ops.push({ stage: 2, method: 'POST', url: `${base}/items/${r.ref}/status`,\n    body: { status: 'in_review', note: `revised after feedback (attempt ${a.attempt}): ${a.reason}` } });\n  else ops.push({ stage: 2, method: 'PATCH', url: `${base}/items/${r.ref}`, body: { notes:\n    `${notesOf[r.ref]}\\n[${new Date().toISOString().slice(0, 19)}Z] revision ${a.attempt} still has problems: ${r.problems.join('; ')}`.trim() } });\n}\nreturn rawOps(ops);\n"
      }
    },
    {
      "id": "0b3e7dcf-5671-5588-9936-0a71de7f577b",
      "name": "Stage 1",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2400,
        300
      ],
      "parameters": {
        "jsCode": "function opsToItems(ops, base) {\n  if (!ops.length) return [{ json: { method: 'GET', url: `${base}/health`, body: '{}', noop: true } }];\n  return ops.map(o => ({ json: { ...o, body: JSON.stringify(o.body || {}) } }));\n}\n\nconst ops = $('Save ops').all().map(i => i.json).filter(o => o.stage === 1);\nreturn opsToItems(ops, $env.CALENDAR_URL);\n"
      }
    },
    {
      "id": "97d17472-a11d-5d03-966c-2df3e2308226",
      "name": "Run stage 1",
      "type": "n8n-nodes-base.httpRequest",
