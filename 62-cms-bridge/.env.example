# /publish needs header X-API-Key with this value. Empty = falls back to INTERNAL_API_KEY.
CMS_BRIDGE_KEY=change-me
# wordpress or ghost
CMS=wordpress

# WordPress: Users -> Profile -> Application Passwords. Sent as HTTP Basic. Never logged or returned.
WP_URL=https://blog.example.com
WP_USER=
WP_APP_PASSWORD=
# draft (default) | pending | private | publish | future (future uses scheduled_at)
WP_STATUS=draft

# Ghost: Settings -> Integrations -> Add custom integration -> Admin API key (id:secret).
GHOST_URL=https://blog.example.com
GHOST_ADMIN_KEY=
# draft (default) | published | scheduled (scheduled uses scheduled_at)
GHOST_STATUS=draft

# Only image_url on these hosts is downloaded (comma list, exact host names).
ALLOWED_IMAGE_HOSTS=image-cards,localhost
# true = validate only, never call the CMS. Set to false to really create posts.
DRY_RUN=true
