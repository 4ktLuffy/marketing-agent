# Shared secret for write endpoints (POST/PATCH/DELETE). Same value as in 01-marketing-stack/.env.
# Also sent as X-API-Key to the calendar, shortener and analytics services.
INTERNAL_API_KEY=change-me
# SQLite file; keep it on the /data volume.
DB_PATH=/data/campaigns.sqlite
# Upstream services on the marketing network.
SHORTENER_URL=http://link-shortener:8000
ANALYTICS_URL=http://analytics-ingest:8000
CALENDAR_URL=http://content-calendar:8000
