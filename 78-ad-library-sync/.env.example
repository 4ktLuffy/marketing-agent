# Shared secret for the keyed endpoints. Same value as in 01-marketing-stack/.env.
INTERNAL_API_KEY=change-me
# Your long-lived Meta user access token (identity confirmed at facebook.com/ID; see README).
# Never commit it. Empty = /sync returns 503; registry, links and suggestions still work.
META_AD_LIBRARY_TOKEN=
META_GRAPH_VERSION=v26.0
# Markets used when a competitor has none. EU examples: only EU countries return commercial ads.
AD_COUNTRIES=DE,FR,NL,IE
AD_LOOKBACK_DAYS=90
# 09-change-monitor: active competitors' key pages become watches there. Empty = not watched.
MONITOR_URL=http://change-monitor:8000
# Suggestion sources (optional).
REVIEWS_URL=http://review-hub:8000
LISTENING_URL=http://social-listening:8000
LISTENING_QUERY=coffee subscription
KB_URL=http://knowledge-base:8000
OWN_DOMAINS=
SUGGEST_MIN_MENTIONS=2
DB_PATH=/data/ads.sqlite
