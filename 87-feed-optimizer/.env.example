# Shared secret for every endpoint but /health. Same value as in 01-marketing-stack/.env.
INTERNAL_API_KEY=change-me
# Second key: approving (and revoking) title changes. Unset = both are refused.
APPROVER_KEY=change-me-too
DB_PATH=/data/feeds.sqlite

# Largest upload in bytes, and most products per upload.
FEED_MAX_BYTES=10000000
FEED_MAX_ROWS=5000

# llm-gateway (03) with the feed_title prompt. Empty = rule-based titles only (no LLM).
GATEWAY_URL=http://llm-gateway:8000
# Seconds one product may take on the gateway (a local model on a laptop is slow).
GATEWAY_TIMEOUT=300
