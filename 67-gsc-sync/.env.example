# Shared secret for POST /sync. Same value as in 01-marketing-stack/.env.
# Also sent as X-API-Key to analytics-ingest when ANALYTICS_URL is set.
INTERNAL_API_KEY=change-me
# Search Console property, exactly as Search Console shows it:
#   domain property      -> sc-domain:example.com
#   URL-prefix property  -> https://example.com/   (with the trailing slash)
GSC_SITE_URL=sc-domain:example.com
# Path to the Google service-account JSON key. Never commit this file.
# Add the service account's client_email as a user of the property (see README).
GSC_CREDENTIALS_FILE=/secrets/gsc.json
# SQLite file with the last sync.
DB_PATH=/data/gsc.sqlite
# Optional: push daily clicks/impressions to 20-analytics-ingest (source=gsc). Empty = off.
ANALYTICS_URL=
