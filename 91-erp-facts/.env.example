# Same value as in 01-marketing-stack/.env.
INTERNAL_API_KEY=change-me
# NEVER set FACT_OWNER_KEY, APPROVER_KEY or any *_OWNER_KEY here: the service refuses to start.
# It only proposes drafts; a person confirms them in 05.

BRAND_URL=http://brand-service:8000
MAPPINGS_FILE=config/mappings.example.yaml

# ERP credentials: set these four, or point ODOO_ENV_FILE at a file (mounted read-only) that has them.
# Use an Odoo API key of a READ-ONLY user. Never put the key in a repo or an image.
ODOO_URL=https://erp.example.com
ODOO_DB=
ODOO_LOGIN=
ODOO_KEY=
# ODOO_ENV_FILE=/run/secrets/odoo.env

# Minutes between automatic syncs (writes drafts only). 0 = off, use POST /sync.
SYNC_EVERY_MIN=0
MAX_RECORDS=2000
UPSTREAM_TIMEOUT=30
