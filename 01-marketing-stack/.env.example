# scripts/install.sh creates .env from this file and generates every secret (INSTALL.md).
# By hand: copy to .env and fill in. Generate secrets with:  openssl rand -hex 24

# Install profile: core, growth or full (INSTALL.md, "1. Pick a profile"; start with core). docker compose reads it, so plain
# `docker compose up -d` starts that profile. install.sh replaces this line with a managed block
# that also empties the URLs of services the profile does not install. Changing it by hand without
# install.sh leaves those URLs pointing at services that are not running: re-run install.sh instead.
COMPOSE_PROFILES=core

POSTGRES_PASSWORD=change-me
N8N_ENCRYPTION_KEY=change-me-and-never-change-again
INTERNAL_API_KEY=change-me
# Only n8n, the calendar and the campaign service get this one: needed to approve or mark a post
# published, and to approve an experiment.
# Must differ from INTERNAL_API_KEY.
APPROVER_KEY=change-me

# Confirms or retires a scoped fact (05). Held only by 05 and the control room, so no AI-driven
# caller can turn a draft into a business fact. install.sh generates it.
FACT_OWNER_KEY=change-me

# Claude connector (89, profile "claude"): bearer token for its HTTP endpoint (≥ 24 characters).
MCP_TOKEN=change-me

# n8n owner login. install.sh creates this account on the first run (password generated here).
# N8N_OWNER_EMAIL=admin@example.com
# N8N_OWNER_PASSWORD=

# Login for the approval, knowledge and rules forms (n8n Basic Auth). Required.
FORMS_USER=reviewer
FORMS_PASSWORD=change-me

# Control room (72, http://localhost:8172): one approver's login, and the key it sends to n8n's
# decision webhook. CONTROL_ROOM_KEY must differ from every other key. Behind HTTPS for phone use.
CONTROL_USER=approver
CONTROL_PASSWORD=change-me
CONTROL_ROOM_KEY=change-me
# Where the control room sends decisions: empty = n8n (default); http://approval-service:8000 =
# the approval service (90), so approving works without n8n (install.sh --approval service).
CONTROL_APPROVAL_URL=
# auto = Secure cookie when the request came over https (your proxy); set true behind HTTPS.
# CONTROL_COOKIE_SECURE=auto

# Where n8n is reachable from your browser (and from webhooks).
N8N_PUBLIC_URL=http://localhost:5678/
# Public base URL of the image cards (17). Post images link here: the approval form shows them in
# the reviewer's browser, so use an address that browser can reach (e.g. https://cards.example.com
# behind your reverse proxy when n8n is not on this machine).
CARDS_PUBLIC_URL=http://localhost:8117
TZ=UTC

# Ollama on the host (Mac: Docker Desktop, OrbStack and colima all resolve host.docker.internal) or
# another machine. Linux + --profile ollama: http://ollama:11434
OLLAMA_URL=http://host.docker.internal:11434
AGENT_MODEL=mkt-agent
WRITER_MODEL=mkt-writer
EMBED_MODEL=qwen3-embedding:0.6b

# Optional: run writing/checking prompts on a hosted OpenAI-compatible model instead of
# Ollama (e.g. Groq). Then set WRITER_MODEL to that provider's model name.
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=
# WRITER_MODEL=openai/gpt-oss-120b
# REASONING_EFFORT=low

# Claim checker (44). CLAIM_CHECK_MODE: lenient (default) or strict.
CLAIM_CHECK_MODE=lenient
# Fact checking can use a stronger model than writing (recommended: hosted). Default: local.
# Hybrid example (writing stays local; checking on Groq, needs OPENAI_* below):
# VERIFIER_PROVIDER=openai
# VERIFIER_MODEL=openai/gpt-oss-20b   (measured: 54/55 invented caught, 2/58 true flagged; local 7B 53/55, 7/58)
VERIFIER_PROVIDER=ollama
VERIFIER_MODEL=mkt-writer
# Extra models callers may request from the gateway (comma-separated). Empty = only its own model.
GATEWAY_ALLOWED_MODELS=

# Public base of the link shortener (e.g. https://go.yourbrand.com)
SHORT_LINK_BASE_URL=http://localhost:8116

# What the morning digest listens for on Hacker News / Reddit.
LISTENING_QUERY=coffee subscription

# Weekly content planner (40).
# instagram needs images (not supported for text-only publishing)
PLAN_CHANNELS=linkedin, x
PLAN_POSTS_PER_CHANNEL=3
PLAN_THEMES=

# Winner recycler (59): each Monday, top posts by short-link clicks become fresh drafts.
# RECYCLE_MIN_CLICKS=5
# RECYCLE_MIN_AGE_DAYS=30
# RECYCLE_PER_WEEK=2

# Review replies (60): each morning, new reviews in the review hub (58) become reply drafts.
# Nothing is posted automatically: a person copies each approved reply to the platform.
# REVIEW_REPLIES_PER_RUN=10

# Content engine drafter (65): each morning it drafts the planned slots of the next days
# (from plan_content_month, 64) and sends them to the approval form.
# ENGINE_DRAFTS_PER_RUN=12
# ENGINE_LOOKAHEAD_DAYS=7

# Content refresh (68, Mondays) and SEO opportunities (69, Wednesdays) read Search Console
# through 67-gsc-sync (set GSC_SITE_URL below). Without it both finish with a message.
# Refresh: pages with at least REFRESH_MIN_CLICKS clicks in the previous 28 days whose clicks
# fell by REFRESH_MIN_DROP (0.3 = 30 %) get a refresh plan in the calendar.
# REFRESH_PER_WEEK=3
# REFRESH_MIN_CLICKS=20
# REFRESH_MIN_DROP=0.3
# SEO briefs: queries at average position SEO_MIN_POSITION..SEO_MAX_POSITION with at least
# SEO_MIN_IMPRESSIONS impressions become blog ideas with a brief from 29.
# SEO_BRIEFS_PER_WEEK=2
# SEO_MIN_IMPRESSIONS=100
# SEO_MIN_POSITION=5
# SEO_MAX_POSITION=20
# SEO_AUDIENCE=

# Experiments (74 proposes weekly, 76 approves, 75 decides): channels the agent may test on
# (default PLAN_CHANNELS) and how many proposals may wait for approval.
# EXPERIMENT_CHANNELS=linkedin, x
# EXPERIMENT_MAX_PROPOSED=2

# Real publishing through Postiz (54). Then set PUBLISH_WEBHOOK_URL=http://postiz-bridge:8000/publish
POSTIZ_URL=
POSTIZ_API_KEY=
# JSON: our channel -> Postiz integration id (see GET http://localhost:8154/integrations)
POSTIZ_CHANNEL_MAP={}
POSTIZ_DRY_RUN=true

# Blog posts to WordPress or Ghost (62), created as drafts by default. The publisher sends
# blog items to CMS_PUBLISH_URL (default http://cms-bridge:8000/publish; set it empty to
# keep blog items out of the publisher). A CMS draft stays "approved" in the calendar with the
# note "sent to CMS as draft: <url>"; it is marked published only when the CMS publishes live.
# CMS_PUBLISH_URL=http://cms-bridge:8000/publish
# CMS_BRIDGE_KEY=          # empty = INTERNAL_API_KEY
# CMS=wordpress            # wordpress | ghost
# WP_URL=https://blog.example.com
# WP_USER=
# WP_APP_PASSWORD=         # Users -> Profile -> Application Passwords
# WP_STATUS=draft          # draft | pending | private | publish | future
# GHOST_URL=https://blog.example.com
# GHOST_ADMIN_KEY=         # id:secret from Settings -> Integrations -> custom integration
# GHOST_STATUS=draft       # draft | published | scheduled
# ALLOWED_IMAGE_HOSTS=image-cards,localhost
# CMS_DRY_RUN=true

# Newsletter to Listmonk as a DRAFT campaign (63); a person presses send in Listmonk.
# n8n calls NEWSLETTER_URL (http://listmonk-bridge:8000) -> POST /campaigns.
# Bundled Listmonk: docker compose --profile newsletter up -d  (UI http://localhost:9000).
# LISTMONK_URL=http://listmonk:9000       # default: the bundled one
# LISTMONK_USER=                          # Listmonk Admin -> Users -> API user
# LISTMONK_TOKEN=
# LISTMONK_AUTH_MODE=token                # token (v4+) | basic (older)
# LISTMONK_LIST_IDS=                      # comma-separated: default audience + allowlist
# LISTMONK_PUBLIC_URL=http://localhost:9000
# LISTMONK_FROM_EMAIL=
# LISTMONK_TEMPLATE_ID=
# Weekly newsletter (66, Fridays 10:00) is built from the week's published items.
# NEWSLETTER_AUDIENCE=existing customers
# NEWSLETTER_DRY_RUN=true
# NEWSLETTER_ALLOW_SCHEDULE=false         # true = a request with send_at is also scheduled
# NEWSLETTER_TEST_EMAILS=                 # comma-separated, must be Listmonk subscribers
# Only for the bundled Listmonk (profile newsletter):
# LISTMONK_VERSION=latest
# LISTMONK_DB_PASSWORD=listmonk
# LISTMONK_ADMIN_USER=                    # set both on first start to create the admin
# LISTMONK_ADMIN_PASSWORD=

# Real analytics from Umami (55 + daily workflow 56). Empty UMAMI_SYNC_URL = off.
UMAMI_SYNC_URL=
UMAMI_URL=
UMAMI_WEBSITE_ID=
UMAMI_USERNAME=
UMAMI_PASSWORD=
UMAMI_API_KEY=
UMAMI_CONVERSION_EVENT=signup

# Google Search Console (67-gsc-sync): declining pages + striking-distance queries.
# Put the service-account JSON key at 01-marketing-stack/secrets/gsc.json (gitignored) and add
# its client_email as a user of the property in Search Console (see 67-gsc-sync/README.md).
# The property exactly as Search Console names it: sc-domain:example.com or https://example.com/
# GSC_SITE_URL=
# Optional: also push daily clicks/impressions to analytics-ingest (source=gsc). Empty = off.
# GSC_ANALYTICS_URL=http://analytics-ingest:8000

# Paid ads (84-ads-sync, growth profile): spend, CPL, ROAS, pacing alerts. READ-ONLY APIs: nothing
# can change a budget or an ad. Every value empty = not configured; each is sent only to its platform
# and never logged. How to get each one: 84-ads-sync/README.md.
# Meta: a System User token with ads_read (Business Settings -> Users -> System users), ad account ids.
# META_ACCESS_TOKEN=
# META_AD_ACCOUNT_IDS=act_123456789
# What counts as a conversion / revenue (Meta action types; overlapping types double-count):
# META_CONVERSION_ACTIONS=lead
# META_REVENUE_ACTIONS=omni_purchase
# Google Ads: developer token (API Center, Basic access), OAuth client + refresh token (scope adwords),
# the account ids to report on, and the manager account id when access goes through one.
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_REFRESH_TOKEN=
# GOOGLE_ADS_CUSTOMER_IDS=123-456-7890
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Alert thresholds (%, days), and the optional daily push to analytics-ingest (source=ads):
# ADS_ALERT_OVERSPEND_PCT=15
# ADS_ALERT_UNDERSPEND_PCT=25
# ADS_ALERT_ZERO_CONV_DAYS=3
# ADS_ANALYTICS_URL=http://analytics-ingest:8000

# Lifecycle email flows (86-flow-runner, growth profile): welcome, onboarding, win-back. Always a
# dry run in this stack (compose fixes DRY_RUN=true): a send is a row in its outbox, never an email.
# Most emails a day over all flows, the kill switch, and the share of new contacts held out (%):
# FLOW_DAILY_CAP=200
# FLOW_PAUSED=false
# FLOW_HOLDOUT_PCT=15

# Product feed optimizer (87-feed-optimizer, full profile): better titles for a Google Merchant
# Center feed file, checked against each product's own row, approved with APPROVER_KEY. Nothing
# is uploaded to Merchant Center. Largest upload (bytes) and most products per upload:
# FEED_MAX_BYTES=10000000
# FEED_MAX_ROWS=5000

# Video assembly (71-video-assembly): video script -> vertical MP4 with captions, fully local.
# Base of the video URLs; the approval form links them, so it must open in the reviewer's browser.
# VIDEO_PUBLIC_URL=http://localhost:8171
# Voice when a request names none: piper (voice model baked into the image) | none.
# VIDEO_TTS_BACKEND=piper
# Delete rendered videos older than this many days. 0 = keep them.
# VIDEO_RETENTION_DAYS=0
# Voice for the previews the workflows (57, 65) request: piper | none. Empty = VIDEO_TTS_BACKEND.
VIDEO_VOICE=
# Largest video postiz-bridge (54) attaches to a post, in MB; a larger one is left off.
# MAX_VIDEO_MB=100

# Clip finder (73-clip-finder): long video (upload or direct media link) -> short vertical clips
# with captions, fully local. You must have the rights to the videos; platform links are refused.
# Base of the clip URLs; the approval form links them, so it must open in the reviewer's browser.
# The postiz-bridge (54) fetches URLs under it from http://clip-finder:8000 instead.
# CLIPS_PUBLIC_URL=http://localhost:8173
# Chat tool 77 (clip_video): minutes to wait for a clip job, and the most clips per video.
# CLIPS_MAX_WAIT_MIN=30
# CLIPS_MAX_PER_VIDEO=5
# faster-whisper model folder baked into the image (small). Another size needs an image rebuild
# with --build-arg WHISPER_REPO=Systran/faster-whisper-<size> plus its WHISPER_REVISION and
# WHISPER_MODEL_SHA256 (see 73-clip-finder/Dockerfile).
# WHISPER_MODEL=/models/faster-whisper-small
# Delete clips and job records older than this many days. 0 = keep them.
# CLIPS_RETENTION_DAYS=0

# Competitor radar (78-ad-library-sync): the competitor registry, their ads from the official
# Meta Ad Library API, and links to the public ad libraries (Google, LinkedIn, TikTok) to open
# by hand. Nothing is scraped. Meta returns commercial ads ONLY for ads delivered in the EU; for
# other markets use the links. The token's Facebook user must have confirmed identity and
# location at facebook.com/ID; see 78-ad-library-sync/README.md. Empty = no ad sync (/sync 503),
# the registry, the page watches and the links still work.
# META_AD_LIBRARY_TOKEN=
# META_GRAPH_VERSION=v26.0
# Countries to ask Meta about when a competitor has no markets (2-letter, EU only has ads):
# AD_COUNTRIES=DE,FR,NL,IE
# Our own domains, never suggested as competitors (comma-separated):
# OWN_DOMAINS=example.com

# Website chat assistant (79-site-assistant). Publish only its public paths through your HTTPS
# reverse proxy (see its README), never /admin. The sites that embed the widget, exact
# scheme://host (comma-separated); empty = no browser may use the chat:
# SITE_ALLOWED_ORIGINS=https://www.example.com
# Booking page offered to qualified visitors (https, e.g. a Cal.com link). Empty = no link:
# BOOKING_URL=
# Lead hub (80) the consented leads go to. Set it empty to keep leads only in 79:
# SITE_LEADS_URL=http://lead-hub:8000
# true when the reverse proxy appends the visitor's address to X-Forwarded-For (rate limits):
# SITE_TRUST_PROXY=false
# Fast answers (INSTALL.md, "Fast site assistant"). On a laptop model a sourced answer takes
# 45-75 s; hosted, a few seconds. PRIVACY: each visitor message and the knowledge-base excerpts
# and facts used to answer it are sent to this provider. COST: one call per answered question
# (about 1-2k tokens; Groq has a free tier with daily limits). Leave these commented to stay local.
# ASSISTANT_OPENAI_API_KEY=
# ASSISTANT_GATEWAY_URL=http://llm-gateway-assistant:8000
# ASSISTANT_MODEL=openai/gpt-oss-120b
# ASSISTANT_OPENAI_BASE_URL=https://api.groq.com/openai/v1
# ASSISTANT_REASONING_EFFORT=low
# The claim check of every answer runs in 44 on the verifier gateway: set VERIFIER_PROVIDER=openai,
# VERIFIER_MODEL=openai/gpt-oss-20b and OPENAI_* above, or it stays on the local model (slow).
# Seconds for the whole answer (search + model + claim check); slower = handed to a person, never
# shown unchecked. Empty = automatic: 20 s with ASSISTANT_GATEWAY_URL set, 120 s all-local.
# ASSISTANT_ANSWER_TIMEOUT_S=

# Lead hub (80-lead-hub): inbound leads -> enrichment from their own website -> score -> CRM ->
# first-reply draft a person approves. CRM calls and alerts stay dry runs until this is false,
# and nothing is ever sent for a lead without consent:
# LEADS_DRY_RUN=true
# Leads not updated for this many days are erased (0 = keep):
# LEADS_RETENTION_DAYS=365
# Form tools posting to /leads/webhook/<source>, per-source secrets (tally=...,typeform=...,n8n=...):
# LEADS_WEBHOOK_SECRETS=
# hubspot,pipedrive: show their dry-run payloads even before tokens are set. Empty = CRMs with a token.
# LEADS_CRM=
# HubSpot private app token (crm.objects.contacts.read/write); optional property for hot/digest/nurture:
# HUBSPOT_TOKEN=
# HUBSPOT_TAG_PROPERTY=
# Pipedrive API token and https://<company>.pipedrive.com; optional label id for nurture leads:
# PIPEDRIVE_TOKEN=
# PIPEDRIVE_BASE_URL=
# PIPEDRIVE_NURTURE_LABEL_ID=

# AI visibility (82-ai-visibility + workflow 83): the approved buyer questions asked weekly to AI
# APIs; is the brand named, cited and described correctly, vs the competitors in 78. Official APIs
# only (scraping chatgpt.com or Google AI Overviews breaks their terms). Each provider runs only
# when its key is set; every key is sent only to that provider and never logged. List prices 2026-09:
# OpenAI Responses + web_search (platform.openai.com -> API keys): ~$0.01 per question + tokens.
# VISIBILITY_OPENAI_API_KEY=
# Perplexity Agent API (perplexity.ai -> Settings -> API): ~$0.0025 per search + tokens.
# VISIBILITY_PERPLEXITY_API_KEY=
# Gemini + Google Search grounding (aistudio.google.com): $35 per 1,000 grounded prompts. Google's
# Gemini API terms forbid analysing Grounded Results; it stays off unless you set the flag below.
# VISIBILITY_GEMINI_API_KEY=
# VISIBILITY_GEMINI_TERMS_ACCEPTED=false
# Groq (console.groq.com, free tier): open model WITHOUT web search, "what the model remembers".
# VISIBILITY_GROQ_API_KEY=
# Daily call caps per provider, answers per question, web-search country (e.g. US):
# VISIBILITY_OPENAI_DAILY_CALLS=100
# VISIBILITY_PERPLEXITY_DAILY_CALLS=100
# VISIBILITY_GEMINI_DAILY_CALLS=100
# VISIBILITY_GROQ_DAILY_CALLS=200
# VISIBILITY_SAMPLES=3
# VISIBILITY_COUNTRY=
# Other names for the brand, and competitor aliases ("Atlas Coffee Club=Atlas; Trade Coffee=Trade"):
# VISIBILITY_BRAND_ALIASES=
# VISIBILITY_COMPETITOR_ALIASES=
# Most calendar ideas (gaps, wrong claims) workflow 83 adds per week:
# VISIBILITY_IDEAS_PER_WEEK=5

# Optional outputs. Empty = the workflow skips that step.
# Where approved posts are sent (Zapier/Make/Buffer hook, or http://postiz-bridge:8000/publish).
PUBLISH_WEBHOOK_URL=
# Sent as X-API-Key to PUBLISH_WEBHOOK_URL. For postiz-bridge set it to your INTERNAL_API_KEY;
# leave empty for outside webhooks so they never receive the internal key.
PUBLISH_WEBHOOK_KEY=
# Notifications (digests, reports, errors, "drafts wait for you" with the approval-form link).
# NOTIFY_FORMAT picks the message shape:
#   generic  (default) {"text","content"} to NOTIFY_WEBHOOK_URL (Teams/Zapier/Make, or any hook)
#   slack    Slack incoming webhook: api.slack.com/apps > Create app > Incoming Webhooks > on >
#            Add New Webhook to Workspace > pick the channel > copy the https://hooks.slack.com/... URL
#   discord  Discord: channel > Edit Channel > Integrations > Webhooks > New Webhook > Copy Webhook URL
#            (messages cut to 2000 characters, no @mentions)
#   telegram Telegram Bot API; NOTIFY_WEBHOOK_URL is not used. Token: message @BotFather, /newbot,
#            copy the token. Chat id: send your bot a message (or add it to a group), open
#            https://api.telegram.org/bot<token>/getUpdates in a browser, copy "chat":{"id":...}
#            (groups are negative numbers). Messages are cut to 4096 characters.
# Webhook URLs and the bot token are secrets: workflows never put them in a message.
NOTIFY_FORMAT=generic
NOTIFY_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Weekly report by email (also attach an SMTP credential in n8n, workflow 41).
REPORT_EMAIL_TO=
REPORT_EMAIL_FROM=

# --- Chat agent (workflow 24): which model route ---------------------------------------------
# local (default) = AGENT_MODEL through the LLM gateway (03 /v1/chat/completions): the gateway's
#   provider (Ollama, or the hosted API when LLM_PROVIDER=openai) and every call on the Activity page.
# direct = n8n talks to Ollama itself, as before (variants/direct-ollama.json; not on the Activity page).
# hosted = any OpenAI-compatible API directly (Groq by default), local fallback. Chat messages and
#   tool results are then sent to that provider. Re-run import-n8n.sh after changing.
CHAT_PROVIDER=local
# CHAT_GATEWAY_URL=http://llm-gateway:8000/v1
CHAT_API_KEY=
CHAT_BASE_URL=https://api.groq.com/openai/v1
CHAT_MODEL=openai/gpt-oss-120b

# Control room behind an HTTPS proxy: the proxy's IPs/CIDRs (e.g. 172.16.0.0/12), else empty.
# CONTROL_TRUSTED_PROXIES=
# CONTROL_UNDO_SECONDS=5
# CONTROL_SESSION_HOURS=12
# CONTROL_SESSION_IDLE_MINUTES=120

# Monthly client report (85): optional. CLIENT_NAME is used when the brand profile has no name,
# REPORT_CURRENCY prefixes analytics money in the table (e.g. "EUR "), CLIENT_REPORT_MONTH=YYYY-MM
# builds that month instead of the last one.
# CLIENT_NAME=
# REPORT_CURRENCY=
# CLIENT_REPORT_MONTH=
