# Shared secret for every endpoint except /health and the form webhooks. Same value as in 01-marketing-stack/.env.
INTERNAL_API_KEY=change-me
# SQLite file; keep it on the /data volume.
DB_PATH=/data/leads.sqlite
# true (default): nothing is sent to a CRM or a notification webhook; the planned requests are stored instead.
DRY_RUN=true
# Leads not updated for this many days are erased (0 = keep forever).
RETENTION_DAYS=365
# Per-source webhook secrets for form tools: tally=...,typeform=...,n8n=...
WEBHOOK_SECRETS=
# CRMs. HubSpot: private app token with crm.objects.contacts.read/write.
HUBSPOT_TOKEN=
# Optional contact property that receives the routing tag (hot / digest / nurture).
HUBSPOT_TAG_PROPERTY=
# Pipedrive: API token and https://<company>.pipedrive.com
PIPEDRIVE_TOKEN=
PIPEDRIVE_BASE_URL=
PIPEDRIVE_NURTURE_LABEL_ID=
# Show CRM plans in a dry run even without tokens: CRM=hubspot,pipedrive
CRM=
# Grade A alerts (Slack/Discord/n8n webhook). Only lead id, score and reasons are sent.
NOTIFY_WEBHOOK_URL=
# Link the first-reply draft offers as the one next step.
BOOKING_URL=
# Services
EXTRACTOR_URL=http://page-extractor:8000
GATEWAY_URL=http://llm-gateway:8000
CLAIMS_URL=http://claim-checker:8000
# Reply drafts are also saved to the calendar as channel lead_reply (status draft). Empty = hub only.
CALENDAR_URL=
# Scoring rules file (default: config/scoring.yaml in the image)
SCORING_RULES=
