# Key for the /admin endpoints; also sent to the gateway, the claim checker and the lead hub.
# Same value as in 01-marketing-stack/.env.
INTERNAL_API_KEY=change-me
# SQLite file; keep it on the /data volume. One instance only (rate limits are in memory).
DB_PATH=/data/site.sqlite
# Services
GATEWAY_URL=http://llm-gateway:8000
BRAND_URL=http://brand-service:8000
KB_URL=http://knowledge-base:8000
CLAIMS_URL=http://claim-checker:8000
# 80 lead-hub. Empty = leads only stay in this service (GET /admin/leads).
LEADS_URL=http://lead-hub:8000
# Slack/Discord/Teams/n8n webhook for handoffs; body {text, content}. Empty = no notification.
NOTIFY_WEBHOOK_URL=
# The sites that embed the widget (exact scheme://host[:port], comma-separated). Empty = no browser may use it.
ALLOWED_ORIGINS=https://www.example.com
# Booking page offered after qualifying (https only), e.g. a Cal.com event link. Empty = no link.
BOOKING_URL=
# Behind a reverse proxy that appends the client address to X-Forwarded-For.
TRUST_PROXY=false
# Abuse limits (defaults shown)
RATE_IP_PER_MINUTE=8
RATE_IP_PER_DAY=150
RATE_SESSION_PER_MINUTE=5
MAX_SESSION_MESSAGES=40
MAX_MESSAGE_CHARS=800
MAX_BODY_BYTES=4096
MAX_CONCURRENT_ANSWERS=2
# Optional: at most 2 qualifying questions, JSON list of {"key","question"}.
# QUALIFY_QUESTIONS=[{"key":"team_size","question":"How many people would it be for?"},{"key":"use_case","question":"What would you mainly use it for?"}]
# Delete idle conversations after this many days (not ones that produced a lead). 0 = keep.
RETENTION_DAYS=90
