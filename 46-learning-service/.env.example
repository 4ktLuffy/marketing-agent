# Shared secret for write endpoints (POST). Same value as in 01-marketing-stack/.env.
INTERNAL_API_KEY=change-me
# SQLite file; keep it on the /data volume.
DB_PATH=/data/learning.sqlite
# LLM gateway (deploy 03); /reflect calls its reflect_rule prompt.
GATEWAY_URL=http://llm-gateway:8000
# Seconds per gateway call during /reflect.
GATEWAY_TIMEOUT=300
