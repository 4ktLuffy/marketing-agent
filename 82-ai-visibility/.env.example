# Shared secret for every write endpoint. Same value as in 01-marketing-stack/.env.
INTERNAL_API_KEY=change-me
# SQLite file; keep it on the /data volume.
DB_PATH=/data/visibility.sqlite

# ---- Providers: each one is used only when its key is set. Keys are sent only in request headers
# to that provider and are never stored, logged or returned. Costs are list prices seen 2026-09.

# OpenAI Responses API with the web_search tool. Key: platform.openai.com -> API keys (needs billing).
# About $0.01 per question (web search $10 per 1,000 calls) + gpt-5-mini tokens ($0.25 / $2.00 per 1M).
VIS_OPENAI_API_KEY=
# VIS_OPENAI_MODEL=gpt-5-mini
# Perplexity Agent API (POST /v1/agent, web_search tool). Key: perplexity.ai -> Settings -> API.
# Sonar chat completions were retired on 2026-09-27. About $0.0025 per search + tokens; the API
# reports the charged cost itself, which is what gets recorded.
VIS_PERPLEXITY_API_KEY=
# VIS_PERPLEXITY_MODEL=perplexity/sonar
# Gemini API with Google Search grounding. Key: aistudio.google.com -> Get API key.
# $35 per 1,000 grounded prompts on Gemini 2.5. Google's Gemini API terms forbid analysing
# "Grounded Results", which is exactly what this service does: it stays OFF until you (or your
# lawyer) decide otherwise and set VIS_GEMINI_TERMS_ACCEPTED=true. See README, "Gemini".
VIS_GEMINI_API_KEY=
VIS_GEMINI_TERMS_ACCEPTED=false
# VIS_GEMINI_MODEL=gemini-2.5-flash
# Groq, open model WITHOUT web search: what the model remembers from training ("model knowledge").
# Key: console.groq.com -> API Keys (free tier with daily limits). gpt-oss-120b: $0.15 / $0.60 per 1M.
VIS_GROQ_API_KEY=
# VIS_GROQ_MODEL=openai/gpt-oss-120b
# VIS_GROQ_REASONING_EFFORT=low

# ---- Caps per provider per UTC day (0 tokens / 0 USD = no cap on that measure). A run stops asking
# a provider when a cap is hit; the questions it skipped are stored as skipped.
VIS_OPENAI_DAILY_CALLS=100
VIS_PERPLEXITY_DAILY_CALLS=100
VIS_GEMINI_DAILY_CALLS=100
VIS_GROQ_DAILY_CALLS=200
# VIS_OPENAI_DAILY_TOKENS=0
# VIS_OPENAI_DAILY_USD=0

# ---- Runs
# Answers per question per provider (answers vary run to run; 3 is the minimum worth reading).
VIS_SAMPLES=3
# Longest answer, in tokens (reasoning tokens count too).
VIS_MAX_OUTPUT_TOKENS=2048
# Two-letter country for the web search location (OpenAI), e.g. US. Empty = none.
VIS_COUNTRY=
# Sentences about us sent to the claim checker per run (each costs 2+ LLM calls there).
VIS_MAX_CLAIM_CHECKS=60

# ---- Who is "us" and who are the competitors
# Other names buyers use for the brand (05 brand.yaml `aliases:` works too), comma-separated.
BRAND_ALIASES=
# Our other domains (the brand website and allowed_domains from 05 are always included).
OWN_DOMAINS=
# Aliases for competitors from the 78 registry: "Atlas Coffee Club=Atlas|Atlas Coffee; Trade Coffee=Trade"
COMPETITOR_ALIASES=
# true: product names from 05 count as brand mentions (off: "Team Box" is too generic for most brands).
COUNT_PRODUCT_NAMES=false

# ---- Services
BRAND_URL=http://brand-service:8000
AD_LIBRARY_URL=http://ad-library-sync:8000
GATEWAY_URL=http://llm-gateway:8000
CLAIMS_URL=http://claim-checker:8000
