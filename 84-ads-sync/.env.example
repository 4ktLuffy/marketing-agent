# Shared secret for the keyed endpoints. Same value as in 01-marketing-stack/.env.
INTERNAL_API_KEY=change-me
DB_PATH=/data/ads-sync.sqlite

# Meta Marketing API (read-only, ads_read). Empty = Meta is not synced. See README: Meta.
# System User token from Business Settings; never commit it.
META_ACCESS_TOKEN=
# Comma-separated ad account ids (act_123 or 123).
META_AD_ACCOUNT_IDS=
META_GRAPH_VERSION=v26.0
# Action types summed as conversions / revenue (overlapping types would double-count: pick one).
META_CONVERSION_ACTIONS=lead
META_REVENUE_ACTIONS=omni_purchase

# Google Ads API (read-only GAQL). Empty = Google Ads is not synced. See README: Google Ads.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Accounts to report on (digits; dashes are fine). The manager account id when access goes through one.
GOOGLE_ADS_CUSTOMER_IDS=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v25

# 45-campaign-service: its slugs map platform campaigns to our campaigns. Empty = mappings/UTM only.
CAMPAIGNS_URL=http://campaign-service:8000
# Optional daily push to 20-analytics-ingest (source=ads). Empty = off.
ANALYTICS_URL=

# Alert rules.
ALERT_OVERSPEND_PCT=15
ALERT_UNDERSPEND_PCT=25
ALERT_MIN_DAYS=3
ALERT_WINDOW_DAYS=7
ALERT_ZERO_CONV_DAYS=3
ALERT_ZERO_CONV_MIN_SPEND=0
ALERT_REPEAT_DAYS=7
