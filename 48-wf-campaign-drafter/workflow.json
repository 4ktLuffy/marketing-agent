    {
      "id": "45c5f628-be11-5758-b011-ebe57b5dafe4",
      "name": "Save ops",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2400,
        300
      ],
      "parameters": {
        "jsCode": "function rawOps(ops) { return ops.length ? ops.map(o => ({ json: o })) : [{ json: { stage: 0 } }]; }\n\nconst base = $env.CALENDAR_URL;\nconst ops = [];\nfor (const r of $input.all().map(i => i.json)) {\n  const id = r.ref;\n  ops.push({ stage: 1, method: 'PATCH', url: `${base}/items/${id}`, body: { body: r.text } });\n  ops.push({ stage: 2, method: 'POST', url: `${base}/items/${id}/status`, body: { status: 'draft',\n    note: r.ok ? 'drafted by campaign drafter' : `drafted; needs a human. Quality gate: ${r.problems.join('; ')}` } });\n  if (r.ok) ops.push({ stage: 3, method: 'POST', url: `${base}/items/${id}/status`, body: { status: 'in_review', note: 'passed the quality gate' } });\n}\nreturn rawOps(ops);\n"
      }
    },
    {
      "id": "fde3c230-5aaf-5570-bed6-91c5bce461ab",
      "name": "Stage 1",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2640,
        300
      ],
      "parameters": {
        "jsCode": "function opsToItems(ops, base) {\n  if (!ops.length) return [{ json: { method: 'GET', url: `${base}/health`, body: '{}', noop: true } }];\n  return ops.map(o => ({ json: { ...o, body: JSON.stringify(o.body || {}) } }));\n}\n\nconst ops = $('Save ops').all().map(i => i.json).filter(o => o.stage === 1);\nreturn opsToItems(ops, $env.CALENDAR_URL);\n"
      }
    },
