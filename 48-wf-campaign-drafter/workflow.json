    {
      "id": "cbfbecac-4e9a-5dfa-a524-2b1495dc48cf",
      "name": "Build request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        300
      ],
      "parameters": {
        "jsCode": "const it = $('One per idea').item.json;\nconst c = $('Campaign').first().json;\nconst link = $('Campaign link').item.json.url || null;\nconst exRaw = $('Approved examples').item.json.body;\nconst examples = (Array.isArray(exRaw) ? exRaw : []).map(e => `- ${e.text}`).join('\\n') || null;\nconst brief = `${it.body}\\nCampaign: ${c.name}. Goal: ${c.goal_text}.${c.offer ? ' Offer: ' + c.offer + '.' : ''}`;\n// Only what the USER gave counts as evidence for the fact check. The piece's brief was\n// written by the planner (an LLM) and once invented \"50% off\"; as evidence it would have\n// approved its own invention.\nconst userFacts = [`Goal: ${c.goal_text}.`, c.offer ? `Offer: ${c.offer}.` : '', c.audience ? `Audience: ${c.audience}.` : ''].filter(Boolean).join('\\n');\nlet request;\nif (it.channel === 'blog') {\n  request = { prompt: 'blog_post', vars: { topic: it.title, audience: c.audience || null, context: brief, length_words: 600 } };\n} else if (it.channel === 'email') {\n  request = { prompt: 'email_newsletter', vars: { topic: it.title, audience: c.audience || null, context: brief } };\n} else {\n  request = { prompt: 'social_posts', vars: { topic: `${it.title}. ${brief}`, channels: it.channel, link, campaign: c.slug, examples } };\n}\nreturn { json: { item_id: it.id, channel: it.channel, link, brief, userFacts, request } };\n",
        "mode": "runOnceForEachItem"
      }
    },
    {
      "id": "758cfaef-81f4-53d9-8e19-618f765ad1b5",
      "name": "Write",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1680,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.GATEWAY_URL }}/v1/run",
        "options": {
          "timeout": 300000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.INTERNAL_API_KEY }}"
            }
