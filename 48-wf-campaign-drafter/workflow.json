      ],
      "parameters": {
        "jsCode": "const raw = [].concat($input.first().json.body ?? []);  // full response: the list is in body\nconst items = (raw.length === 1 && Array.isArray(raw[0]) ? raw[0] : raw).filter(i => i && i.id && i.status === 'idea');\nreturn items.map(i => ({ json: i }));\n"
