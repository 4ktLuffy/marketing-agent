    {
      "id": "77cb7318-b467-5ae7-ad77-1dc1a1b632d7",
      "name": "Draft text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        300
      ],
      "parameters": {
        "jsCode": "const b = $('Build request').item.json;\nconst out = $json.output;\nlet text;\nif (b.channel === 'blog') text = out;\nelse if (b.channel === 'email') text = `Subject: ${out.subject}\\nPreheader: ${out.preheader}\\n\\n${out.body_markdown}`;\nelse {\n  const post = (out.posts || []).find(p => String(p.channel).trim().toLowerCase() === b.channel) || (out.posts || [])[0];\n  if (!post) throw new Error(`No post for ${b.channel}`);\n  text = post.text.trim();\n  if (b.link && !text.includes(b.link)) text += `\\n\\n${b.link}`;\n}\nreturn { json: { ref: String(b.item_id), channel: b.channel, text, context: b.userFacts, links: b.link || '' } };\n",
        "mode": "runOnceForEachItem"
      }
    },
