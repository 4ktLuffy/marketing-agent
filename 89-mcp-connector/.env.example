# The ONLY secret this connector holds. Same value as in 01-marketing-stack/.env.
INTERNAL_API_KEY=change-me
# NEVER set APPROVER_KEY, FACT_OWNER_KEY or any *_APPROVER_KEY / *_OWNER_KEY here: the connector
# refuses to start if one is present. Approving and confirming facts are for a person, in 72.

# Brand service (05: facts) and task bridge (88: packs, paste, submit, check, blockers).
BRAND_URL=http://brand-service:8000
TASK_BRIDGE_URL=http://task-bridge:8000

# Longest text a tool accepts (submit_answer, check_text). Keep <= 88's PASTE_MAX_CHARS.
MAX_TEXT_CHARS=40000
# Tool calls per minute, all callers together (stdio and HTTP).
TOOL_CALLS_PER_MIN=30
# Seconds to wait for 05/88 (submit can take long when 88's model check is on).
UPSTREAM_TIMEOUT=150

# ---- HTTP transport only (python -m app http) ----
# Any address other than 127.0.0.1/localhost/::1 needs MCP_TOKEN (the Docker image uses 0.0.0.0).
MCP_HOST=127.0.0.1
MCP_PORT=8000
# Bearer token, at least 24 random characters:
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
MCP_TOKEN=
# true = also accept the token as the last path segment, https://host/mcp/<token>, for a client
# that cannot send an Authorization header. Weaker (URLs end up in logs and history); see README.
MCP_TOKEN_IN_PATH=false
# Public hostname(s) a tunnel sends in the Host header, comma separated (e.g. abc.ngrok-free.app).
# Needed when the server listens on localhost behind a tunnel that keeps the public Host header.
MCP_ALLOWED_HOSTS=
# HTTP requests per minute (all callers; failed logins count), and the largest request body.
HTTP_REQUESTS_PER_MIN=120
MAX_BODY_BYTES=1048576
# true = plain JSON responses (works through tunnels without streaming); false = SSE streams.
MCP_JSON_RESPONSE=true
