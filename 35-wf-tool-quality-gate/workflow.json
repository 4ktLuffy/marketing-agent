        "url": "={{ $env.REVIEWS_URL ? $env.REVIEWS_URL + '/testimonials/check' : $env.BRAND_URL + '/health' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $('Rewrite').item.json.output.text }) }}",
        "options": {
