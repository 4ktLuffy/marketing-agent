        "jsCode": "const p = $json;\nreturn { json: { ref: p.ref, ok: true, text: p.text, channel: p.channel, rewritten: false, fixed: [],\n  problems: [], warnings: p.warnings, readability: p.readability } };\n",
        "mode": "runOnceForEachItem"
      }
    },
