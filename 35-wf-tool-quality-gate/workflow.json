    {
      "id": "324e585c-c22d-51dc-aaaf-4e6d67575ba9",
      "name": "Fixed",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3120,
        200
      ],
      "parameters": {
        "jsCode": "const prev = $('Collect problems').item.json;\nconst text = $('Rewrite').item.json.output.text;\nconst b = $('Recheck brand').item.json;\nconst r = $('Recheck rules').item.json;\nconst cl = $('Recheck claims').item.json;\nconst q = $('Recheck quotes').item.json;\nconst errors = v => (v || []).filter(x => (x.severity || 'error') === 'error');\nconst remaining = [\n  ...errors(b.violations).map(v => `brand: ${v.detail}`),\n  ...errors(r.violations).map(v => `${prev.channel}: ${v.detail}`),\n  ...(cl.unsupported || []).map(u => `unsupported claim: ${u}`),\n  ...($env.REVIEWS_URL ? (q.violations || []).map(v => `quote is not a real testimonial with consent: \"${v.text}\"`) : []),\n];\nconst warns = v => (v || []).filter(x => x.severity === 'warn').map(x => x.detail);\nconst warnings = [...warns(b.violations), ...warns(r.violations)];\nif (typeof cl.ok !== 'boolean') warnings.push('claims NOT fact-checked (claim checker unavailable)');\nif ($env.REVIEWS_URL && typeof q.ok !== 'boolean') warnings.push('quotes NOT checked against the testimonials (review hub unavailable)');\nreturn { json: { ref: prev.ref, ok: remaining.length === 0, text, channel: prev.channel, rewritten: true,\n  fixed: prev.problems, problems: remaining, warnings, readability: prev.readability } };\n",
        "mode": "runOnceForEachItem"
      }
    },
    {
      "id": "eed5138e-7124-5935-be9a-edcd783cce71",
      "name": "Passed",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        420
      ],
      "parameters": {
        "jsCode": "const p = $json;\n// Also reached with problems when the caller asked for rewrite \"no\": report them, never \"ok\".\n// (Night 5: a video script with a banned emoji and an unsupported claim went to review as ok.)\nreturn { json: { ref: p.ref, ok: p.problems.length === 0, text: p.text, channel: p.channel, rewritten: false,\n  fixed: [], problems: p.problems, warnings: p.warnings, readability: p.readability } };\n",
        "mode": "runOnceForEachItem"
      }
    },
