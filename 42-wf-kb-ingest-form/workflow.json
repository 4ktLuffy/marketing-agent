      ],
      "parameters": {
        "operation": "completion",
        "respondWith": "text",
        "completionTitle": "Added",
        "completionMessage": "=Saved “{{ $('Document').first().json.title }}” as {{ $json.chunks }} searchable chunks. Adding the same title again replaces it.",
        "options": {}
      }
    }
  ],
