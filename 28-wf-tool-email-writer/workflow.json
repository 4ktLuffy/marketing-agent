        "url": "={{ $env.EMAIL_RENDER_URL }}/render",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ subject: $('Write email').first().json.output.subject, preheader: $('Write email').first().json.output.preheader, body_markdown: $('Quality gate').first().json.text, cta_text: $('Start').first().json.cta_url ? $('Write email').first().json.output.cta_text : null, cta_url: $('Start').first().json.cta_url || null }) }}"
      }
    },
    {
      "id": "244df9cf-ca76-5ea8-8fa2-47557b0e824b",
      "name": "Save draft",
      "type": "n8n-nodes-base.httpRequest",
