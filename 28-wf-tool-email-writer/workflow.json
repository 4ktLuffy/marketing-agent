              "value": "={{ $env.INTERNAL_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ prompt: 'email_newsletter', vars: { topic: $json.topic, audience: $json.audience || null, context: $json.context || null } }) }}"
      }
    },
    {
