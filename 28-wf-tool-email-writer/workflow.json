    {
      "id": "6445fa75-33bb-57ac-8a90-b0f18d5a0d4f",
      "name": "Build context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "jsCode": "const start = $('Start').first().json;\nconst results = ($input.first().json.results || []).filter(r => r.score >= 0.35);\nconst context = results.map((r, i) => `[${i + 1}] (${r.title}) ${r.chunk}`).join('\\n');\nreturn [{ json: { ...start, context } }];\n"
      }
    },
    {
      "id": "6e0137e2-1f44-5814-9a0f-38aa5f8ab368",
      "name": "Write email",
      "type": "n8n-nodes-base.httpRequest",
