      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CALENDAR_URL }}/items",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.INTERNAL_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ title: ('Email: ' + $('Write email').first().json.output.subject).slice(0, 120), channel: 'email', body: 'Subject: ' + $('Write email').first().json.output.subject + '\\nPreheader: ' + $('Write email').first().json.output.preheader + '\\n\\n' + $('Quality gate').first().json.text, status: $('Quality gate').first().json.ok ? 'in_review' : 'draft', link: $('Start').first().json.cta_url || null }) }}"
      }
    },
    {
      "id": "e75dc964-8479-5b04-82c6-b734579443e9",
      "name": "Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        300
      ],
      "parameters": {
        "jsCode": "const e = $('Write email').first().json.output;\nconst g = $('Quality gate').first().json;\nconst subj = $('Subject check').first().json;\nconst s = $input.first().json;\nconst notes = [];\nif (g.rewritten) notes.push(`auto-fixed: ${g.fixed.join('; ')}`);\nif (g.problems.length) notes.push(`needs a human: ${g.problems.join('; ')}`);\nfor (const v of subj.violations || []) notes.push(`subject: ${v.detail}`);\nreturn [{ json: { result: [\n  `Saved as calendar #${s.id} (${s.status}). HTML version rendered (${$('Render HTML').first().json.html.length} chars).`,\n  `**Subject:** ${e.subject}`, `**Preheader:** ${e.preheader}`, '', g.text, '', `CTA: ${e.cta_text}`,\n  notes.length ? `_${notes.join(' · ')}_` : '',\n].join('\\n') } }];\n"
      }
    }
