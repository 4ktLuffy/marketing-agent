OLLAMA_URL=http://host.docker.internal:11434
MODEL=qwen2.5:7b
PROMPTS_DIR=/prompts
BRAND_URL=http://brand-service:8000
# Optional: learned rules (deploy 46) appended to the brand text. Leave empty to disable.
LEARNING_URL=http://learning-service:8000
MAX_ATTEMPTS=3
NUM_CTX=8192
REQUEST_TIMEOUT=240

