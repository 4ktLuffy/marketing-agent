{
  "id": "mktWf76ExpForm00",
  "name": "76 · Form · Review experiments",
  "nodes": [
    {
      "id": "2579f35a-ffac-5c16-a1cc-4376b2030f8b",
      "name": "Open experiments form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "authentication": "basicAuth",
        "formTitle": "Experiments proposed by the agent",
        "formDescription": "Approve an experiment and the content engine starts giving its two versions to planned posts. Nothing is published without your approval of each post.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Reviewer",
              "placeholder": "your name",
              "requiredField": true
            }
          ]
        },
        "responseMode": "lastNode",
        "options": {}
      },
      "webhookId": "mkt-experiments",
      "credentials": {
        "httpBasicAuth": {
          "id": "mktFormsLogin001",
          "name": "Forms login"
        }
      }
    },
    {
      "id": "39a03479-4ea2-5007-b4e3-7c1b9aa18352",
      "name": "Proposed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.CAMPAIGNS_URL }}/experiments",
        "options": {
          "response": {
            "response": {
              "fullResponse": true
            }
          }
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "status",
              "value": "proposed"
            }
          ]
        }
      }
    },
    {
      "id": "a9f05723-08e0-5fa3-bb7f-ed3c4610af1d",
      "name": "Build page",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "jsCode": "const listOf = n => { try { const raw = [].concat($(n).first().json.body ?? []);\n  return (raw.length === 1 && Array.isArray(raw[0]) ? raw[0] : raw).filter(x => x && x.id); } catch (e) { return []; } };\n\nconst esc = s => String(s ?? '').replace(/[&<>\"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;' }[c]));\nconst exps = listOf('Proposed').slice(0, 10);\nconst fields = [];\nfor (const e of exps) {\n  const arms = (e.arms || []).map(a => `<li><b>${esc(a.label)}</b>: ${esc(a.value)}${a.brief ? ` <i>(${esc(a.brief)})</i>` : ''}</li>`).join('');\n  fields.push({ fieldType: 'html', html: `<p><b>#${e.id} · ${esc(e.variable)} on ${esc(e.channels.join(', '))}</b>` +\n    ` <small>(proposed by ${esc(e.created_by)})</small></p><p>${esc(e.hypothesis)}</p><ul>${arms}</ul>` +\n    `<p><small>Metric: clicks per post within 72 h of publishing. Stops when both versions have ${e.min_posts_per_arm} posts ` +\n    `and the 95% interval of the lift clears ±${Math.round(e.rope * 100)}%, or after ${e.max_weeks} weeks; checked weekly. ` +\n    `Every post is still approved one by one.</small></p>` });\n  fields.push({ fieldLabel: `Experiment #${e.id}`, fieldType: 'dropdown', requiredField: true,\n    fieldOptions: { values: [{ option: 'Decide later' }, { option: 'Approve' }, { option: 'Reject' }] } });\n}\nreturn [{ json: { count: exps.length, fields } }];\n"
      }
    },
    {
      "id": "e10e662c-f3ea-5bec-8bdc-59ec8ec9a075",
      "name": "Any proposed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "0f1e3cb2-a493-5749-a4cc-44a939030de2",
              "leftValue": "={{ $json.count > 0 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "86f5e2a7-2936-51fa-876d-959690aba112",
      "name": "Experiments page",
      "type": "n8n-nodes-base.form",
      "typeVersion": 2.3,
      "position": [
        960,
        200
      ],
      "parameters": {
        "operation": "page",
        "defineForm": "json",
        "jsonOutput": "={{ JSON.stringify($json.fields) }}",
        "options": {
          "formTitle": "Experiments proposed by the agent",
          "buttonLabel": "Save"
        }
      }
    },
    {
      "id": "87a46170-f888-56b4-b8e0-1b5a8723c093",
      "name": "Decisions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        200
      ],
      "parameters": {
        "jsCode": "function opsToItems(ops, base) {\n  if (!ops.length) return [{ json: { method: 'GET', url: `${base}/health`, body: '{}', noop: true } }];\n  return ops.map(o => ({ json: { ...o, body: JSON.stringify(o.body || {}) } }));\n}\n\nconst base = $env.CAMPAIGNS_URL;\nconst f = $input.first().json;\nconst who = String($('Open experiments form').first().json['Reviewer'] || 'reviewer').slice(0, 100);\nconst map = { 'Approve': 'approved', 'Reject': 'stopped' };\nconst ops = Object.entries(f).map(([k, v]) => [k.match(/^Experiment #(\\d+)$/), v]).filter(([m, v]) => m && map[v])\n  .map(([m, v]) => ({ method: 'POST', url: `${base}/experiments/${m[1]}/status`, label: `#${m[1]} ${v.toLowerCase()}d`,\n    body: { status: map[v], by: who, reason: v === 'Reject' ? `rejected in the form by ${who}` : null } }));\nreturn opsToItems(ops, base);\n"
      }
    },
    {
      "id": "fe0897a3-0513-5df7-925c-c0e0c9541b5b",
      "name": "Save decisions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        200
      ],
      "parameters": {
        "method": "={{ $json.method }}",
        "url": "={{ $json.url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.INTERNAL_API_KEY }}"
            },
            {
              "name": "X-Approver-Key",
              "value": "={{ $env.APPROVER_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.body || '{}' }}",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          }
        }
      }
    },
    {
      "id": "8d920ebc-75ea-5e8c-8826-e409fd2da2c4",
      "name": "Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        200
      ],
      "parameters": {
        "jsCode": "const ops = $('Decisions').all().map(i => i.json);\nconst lines = $input.all().map((r, i) => ops[i].noop ? null : `${ops[i].label}: ${r.json.statusCode < 300 ? 'saved' :\n  'failed (' + JSON.stringify((r.json.body || {}).detail ?? r.json.body).slice(0, 120) + ')'}`).filter(Boolean);\nreturn [{ json: { message: lines.length ? lines.join('\\n') : 'Nothing decided.' } }];\n"
      }
    },
    {
      "id": "6c59f569-0ee7-5c0d-b88e-b7f7be284418",
      "name": "Done",
      "type": "n8n-nodes-base.form",
      "typeVersion": 2.3,
      "position": [
        1920,
        200
      ],
