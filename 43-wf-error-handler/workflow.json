{
  "id": "mktWf43ErrorHand",
  "name": "43 · Error handler",
  "nodes": [
    {
      "id": "c4523612-e360-50b5-bf35-6396a4d9df73",
      "name": "On workflow error",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ],
      "parameters": {}
    },
    {
      "id": "b7edbfae-43f5-57b3-8a79-a9bb913e4f53",
      "name": "Format",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "jsCode": "const e = $input.first().json;\nconst text = [\n  `❌ *${e.workflow?.name || 'A workflow'}* failed`,\n  `Node: ${e.execution?.lastNodeExecuted || 'unknown'}`,\n  `Error: ${e.execution?.error?.message || e.trigger?.error?.message || 'unknown'}`,\n  e.execution?.url ? `Execution: ${e.execution.url}` : '',\n].filter(Boolean).join('\\n');\nreturn [{ json: { text } }];\n"
      }
    },
    {
      "id": "3a4f5348-02d5-5cb5-9183-57b60e6f458b",
      "name": "Webhook set?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "jsCode": "// Skip notifying when no webhook is configured.\nreturn $env.NOTIFY_WEBHOOK_URL ? $input.all() : [];\n"
      }
    },
    {
      "id": "72155fda-67f1-5f22-866c-989f3582b9d4",
      "name": "Notify",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.NOTIFY_WEBHOOK_URL }}",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.text, content: $json.text }) }}"
      },
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "On workflow error": {
      "main": [
        [
          {
            "node": "Format",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format": {
      "main": [
        [
          {
            "node": "Webhook set?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Webhook set?": {
      "main": [
        [
          {
            "node": "Notify",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "pinData": {},
  "tags": []
}
