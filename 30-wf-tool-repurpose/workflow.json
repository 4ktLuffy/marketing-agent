    {
      "id": "efd77ea9-2b1c-54e8-9285-42aa125c02b9",
      "name": "Fetch page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EXTRACTOR_URL }}/extract",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
