    {
      "id": "bd56437d-356b-57fc-96d7-a109650ce8c0",
      "name": "Prepare",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "jsCode": "const KNOWN = ['x', 'linkedin', 'instagram', 'facebook', 'threads', 'mastodon'];\nconst ALIAS = { twitter: 'x', 'x/twitter': 'x', ig: 'instagram', insta: 'instagram', fb: 'facebook' };\nfunction normalizeChannels(raw) {\n  const list = String(raw || 'linkedin')\n    .split(/,|;|\\/| and |&/)\n    .map(c => c.trim().toLowerCase())\n    .map(c => ALIAS[c] || c)\n    .filter(c => KNOWN.includes(c));\n  const unique = [...new Set(list)];\n  if (!unique.length) throw new Error(`No supported channel in \"${raw}\". Use: ${KNOWN.join(', ')}`);\n  return unique;\n}\n\nconst s = $('Start').first().json;\nconst page = $input.first().json;\nconst source = (s.text || '').trim() || (page.text || '').trim();\nif (!source) throw new Error(s.url ? `Could not read ${s.url}: ${JSON.stringify(page.detail || page)}` : 'Give a url or text to repurpose');\nreturn [{ json: { source, title: page.title || null, channels: normalizeChannels(s.channels),\n  link: (s.link || s.url || '').trim(), campaign: 'repurpose' } }];\n"
      }
    },
    {
      "id": "4ed0d63c-5ed9-56f8-a928-41985c91e601",
      "name": "Write posts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.GATEWAY_URL }}/v1/run",
        "options": {
          "timeout": 300000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.INTERNAL_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ prompt: 'repurpose', vars: { source_text: $json.source, source_title: $json.title, channels: $json.channels.join(', '), link: $json.link || null } }) }}"
      }
    },
    {
      "id": "932ba2b8-ca80-5605-a216-bce8da4b413a",
      "name": "Split posts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        300
      ],
      "parameters": {
        "jsCode": "// Small models sometimes add channels nobody asked for, or drop the link. Fix both here,\n// deterministically, instead of trusting the model.\nconst p = $('Prepare').first().json;\nconst seen = new Set();\nconst out = [];\nfor (const post of $input.first().json.output.posts || []) {\n  const channel = String(post.channel || '').trim().toLowerCase();\n  if (!p.channels.includes(channel) || seen.has(channel)) continue;\n  seen.add(channel);\n  let text = String(post.text || '').trim();\n  if (p.link && !text.includes(p.link)) text += `\\n\\n${p.link}`;\n  out.push({ json: { channel, text } });\n}\nif (!out.length) throw new Error('The model returned no posts for the requested channels');\nreturn out;\n"
      }
    },
