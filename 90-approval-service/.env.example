# All four are required: without one (or with a CONTROL_ROOM_KEY under 16 characters, or equal
# to one of the other keys) POST /decisions answers 503 and GET /health says what is missing.

# Same value as in 01-marketing-stack/.env: every call to the content calendar (19).
INTERNAL_API_KEY=change-me
# Same value as in 01-marketing-stack/.env. 19 approves only with it. This service and n8n are
# the only holders; the control room (72) never has it.
APPROVER_KEY=change-me-too
# The control room (72) sends it as X-Control-Key. Same value as CONTROL_ROOM_KEY in 72's .env.
# At least 16 characters, different from the two keys above.
CONTROL_ROOM_KEY=change-me-to-a-long-random-value
CALENDAR_URL=http://content-calendar:8000

# Optional: learning events (46) and content-engine outcomes (61). Empty = not sent.
# Both are fail-soft: if one is down, the decisions are still saved and the summary says so.
LEARNING_URL=http://learning-service:8000
ENGINE_URL=http://content-engine:8000

# Seconds per call to 19, 46 and 61 (1 to 120).
REQUEST_TIMEOUT=15
