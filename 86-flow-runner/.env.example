# Shared secret for every endpoint but /health. Same value as in 01-marketing-stack/.env.
INTERNAL_API_KEY=change-me
# Second key: approving a flow version and resuming after a pause. Unset = both are refused.
APPROVER_KEY=change-me-too
DB_PATH=/data/flows.sqlite

# Only an explicit false turns the dry run off. The real send path is a stub (see README).
DRY_RUN=true
# Most outbox rows (sends) per UTC day over all flows. 0 = nothing is sent.
FLOW_DAILY_CAP=200
# Kill switch. true = nothing is sent and nobody enters a flow; POST /resume cannot override it.
FLOW_PAUSED=false
# Share of new contacts held out (0 to 50 %). Per flow: PATCH /flows/{name} {"holdout_pct": 20}.
FLOW_HOLDOUT_PCT=15
# Salt for the arm hash. Empty = one is generated once and kept in the database.
FLOW_SALT=
# Results say "not enough data" under this many contacts in an arm.
FLOW_MIN_N=100
# An event older than this does not start a flow (no burst of old emails after an import).
FLOW_ENTRY_MAX_AGE_HOURS=48
# Hours between two emails of one flow to one contact, whatever the steps say.
FLOW_MIN_GAP_HOURS=12

# Other services. Empty = not installed.
CALENDAR_URL=http://content-calendar:8000
GATEWAY_URL=http://llm-gateway:8000
CLAIMS_URL=http://claim-checker:8000
NEWSLETTER_URL=http://listmonk-bridge:8000
