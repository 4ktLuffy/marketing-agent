# Required for POST /render (same value as in 01-marketing-stack/.env).
INTERNAL_API_KEY=change-me
# Videos and posters live under $DATA_DIR/videos; keep it on the /data volume.
DATA_DIR=/data
# Base of the returned URLs. The approval form links the video from here, so it must be
# reachable from the reviewer's browser.
PUBLIC_BASE_URL=http://localhost:8171
# Voice when a request doesn't name one: piper | say (macOS dev only) | none.
TTS_BACKEND=piper
# Piper voice model (.onnx, with its .onnx.json next to it). The Docker image ships one.
PIPER_VOICE=/voices/en_US-lessac-medium.onnx
# Caps.
MAX_SECONDS=90
FFMPEG_TIMEOUT=180
MAX_CONCURRENT_RENDERS=2
# Delete stored videos older than this many days (checked at startup and on each render). 0 = keep.
RETENTION_DAYS=0
# Optional fonts; the image ships DejaVu.
FONT_PATH=
FONT_BOLD_PATH=
