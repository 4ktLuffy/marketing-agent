# Optional. Docker image ships DejaVu; set these to use another TTF/OTF.
FONT_PATH=
FONT_BOLD_PATH=
# Required for POST /cards (same value as in 01-marketing-stack/.env).
INTERNAL_API_KEY=change-me
# Where POST /cards keeps PNGs, and the public base of the URLs it returns.
DATA_DIR=/data/cards
PUBLIC_BASE_URL=http://localhost:8117
