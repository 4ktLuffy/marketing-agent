{
  "id": "mktWf50LearnRevi",
  "name": "50 · Schedule · Learn from reviews",
  "nodes": [
    {
      "id": "a62e8ada-3694-596e-9c88-3918d6762a6c",
      "name": "Fridays 16:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 16 * * 5"
            }
          ]
        }
      }
    },
    {
      "id": "9c5e2cd3-c80a-5454-99ef-9ac554f02d4a",
      "name": "Reflect",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LEARNING_URL }}/reflect",
        "options": {
          "timeout": 1800000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.INTERNAL_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ since_days: 7, max_events: 30 }) }}"
      }
    },
    {
      "id": "0b70fa7c-3cf2-58cc-87ec-167d0625051a",
      "name": "New rules",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "jsCode": "const res = $input.first().json;\nconst rules = res.created || [];\nif (!rules.length) return [];\nconst form = `${$env.N8N_PUBLIC_URL || ''}form/mkt-rules-review`;\nreturn [{ json: { text: `*${rules.length} new writing rule(s) proposed from this week's reviews*\\n` +\n  rules.map(r => `- ${r.scope !== 'all' ? '[' + r.scope + '] ' : ''}${r.text}`).join('\\n') +\n  `\\nKeep or reject them: ${form}` } }];\n"
      }
    },
    {
      "id": "e58886a4-fbeb-5f82-8d37-98c9e01bcdfd",
      "name": "Webhook set?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "jsCode": "return $env.NOTIFY_WEBHOOK_URL ? $input.all() : [];\n"
      }
    },
    {
      "id": "c5e70fed-937d-5c9a-9501-a04aa591cdcd",
      "name": "Notify",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.NOTIFY_WEBHOOK_URL }}",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.text, content: $json.text }) }}"
      },
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Fridays 16:00": {
      "main": [
        [
          {
            "node": "Reflect",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Reflect": {
      "main": [
        [
          {
            "node": "New rules",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "New rules": {
      "main": [
        [
          {
            "node": "Webhook set?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Webhook set?": {
      "main": [
        [
          {
            "node": "Notify",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "mktWf43ErrorHand"
  },
  "active": false,
  "pinData": {},
  "tags": []
}
