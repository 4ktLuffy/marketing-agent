        300
      ],
      "parameters": {
        "jsCode": "const start = $('Start').first().json;\nconst results = ($input.first().json.results || []).filter(r => r.score >= 0.35);\nconst context = results.map((r, i) => `[${i + 1}] (${r.title}) ${r.chunk}`).join('\\n');\nreturn [{ json: { ...start, context } }];\n"
      }
    },
