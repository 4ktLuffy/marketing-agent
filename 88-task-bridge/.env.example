# Shared secret for every endpoint but /health. Same value as in 01-marketing-stack/.env.
INTERNAL_API_KEY=change-me
DB_PATH=/data/tasks.sqlite

# Required: brand service (05: facts, voice, brand check, fact changes) and content calendar (19).
BRAND_URL=http://brand-service:8000
CALENDAR_URL=http://content-calendar:8000
# Optional: platform rules (14). Empty = no channel rules in the pack, no length check.
RULES_URL=http://platform-rules:8000
# Optional: lead hub (80), only for the "leads waiting" line of GET /blockers.
LEADS_URL=

# Optional model check through the claim checker (44). off (default) = zero model calls.
# auto = also ask 44; it can only ADD non-blocking findings, never remove one.
# review = send only unsure sentences (rule "review" or offer/scope/claim cues, max 12 per piece);
#          adds non-blocking "review" notes only (see README: measured result).
MODEL_CHECK=off
CLAIMS_URL=
CLAIMS_TIMEOUT=120
SERVICE_TIMEOUT=15

# The pack must fit a free chatbot plan. Longer packs drop the least relevant facts (listed as withheld).
PACK_MAX_CHARS=8000
# Largest paste-back, and paste/submit/check calls per minute.
PASTE_MAX_CHARS=40000
RATE_PER_MIN=60
# Minutes between fact-change reconcile runs (0 = only POST /reconcile).
RECONCILE_MIN=10
