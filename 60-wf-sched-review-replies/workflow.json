        "jsCode": "const d = $('Save item').first().json;\nconst r = $('Mark drafted').first().json;\nconst x = $('Has reply?').first().json;\nreturn [{ json: { review_id: x.review_id, source: x.source, rating: x.rating, item_id: d.id, status: d.status,\n  escalated: x.escalated, marked: r.status === 'drafted', notes: d.notes } }];\n"
      }
    },
    {
      "id": "c36ffae2-aea1-5e32-bf76-aa4fa4d1a351",
      "name": "Record skipped",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3600,
        520
      ],
      "parameters": {
        "jsCode": "return [{ json: $input.first().json }];   // stays new: retried next run\n"
      }
    },
    {
      "id": "f46b2992-c67d-578f-8464-4f6328f96497",
      "name": "Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3600,
        100
      ],
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst saved = rows.filter(r => r.item_id);\nconst failed = rows.filter(r => !r.item_id);\nconst notes = ($('Pick reviews').first().json.notes) || [];\nconst line = r => `- ${r.source} review #${r.review_id} (${r.rating}★) → calendar #${r.item_id} (${r.status})` +\n  (r.escalated ? ' · needs a person' : '') + (r.marked ? '' : ' · review NOT marked drafted');\nreturn [{ json: { text: [\n  `*Review replies*: ${saved.length} reply draft${saved.length === 1 ? '' : 's'} saved to the calendar. ` +\n  'Nothing is posted: after approval, a person copies each reply to Google or Trustpilot.',\n  ...saved.map(line),\n  ...failed.map(r => `- review #${r.review_id}: not drafted, ${r.error} (it stays new and is retried next run)`),\n  ...notes.map(n => `- ${n}`),\n].join('\\n'), saved: saved.length, failed: failed.length, items: rows } }];\n"
      }
    },
