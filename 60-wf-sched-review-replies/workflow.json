      "id": "3e846292-a2d9-5a1b-b658-fe020a19cb9c",
      "name": "Draft reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1920,
        300
      ],
      "parameters": {
