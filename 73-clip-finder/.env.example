# Required for POST /jobs and GET /jobs/{id} (same value as in 01-marketing-stack/.env).
INTERNAL_API_KEY=change-me
# Jobs, clips and temp work live under $DATA_DIR; keep it on the /data volume.
DATA_DIR=/data
# Base of the returned clip URLs. The approval form links clips from here, so it must be
# reachable from the reviewer's browser.
PUBLIC_BASE_URL=http://localhost:8173
# LLM gateway (03) that runs prompt clip_scoring.
GATEWAY_URL=http://llm-gateway:8000
GATEWAY_TIMEOUT=300
# faster-whisper model: a size name (small, base, medium, ...) or a local folder. The image
# ships small at /models/faster-whisper-small and never downloads at run time.
WHISPER_MODEL=/models/faster-whisper-small
WHISPER_COMPUTE=int8
WHISPER_THREADS=0
WHISPER_BEAM=5
# Caps.
MAX_UPLOAD_MB=1024
MAX_SOURCE_MINUTES=90
MAX_CLIPS=10
DOWNLOAD_TIMEOUT=60
FFMPEG_TIMEOUT=600
# Candidates: start spacing, how many are scored, per gateway call, lowest score kept (0-100).
WINDOW_STRIDE_S=8
MAX_CANDIDATES=48
SCORE_BATCH=6
MIN_SCORE=0
# Delete clips and job records older than this many days (checked at startup and per job). 0 = keep.
RETENTION_DAYS=0
# Direct media links to private addresses (a NAS on the LAN, say). Off by default: SSRF guard.
ALLOW_PRIVATE_URLS=false
# Optional caption font (a TTF/OTF file and its family name); the image ships DejaVu Sans Bold.
CAPTION_FONT_FILE=
CAPTION_FONT_NAME=
