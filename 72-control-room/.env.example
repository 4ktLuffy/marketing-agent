# Login (one approver). CONTROL_PASSWORD is required: without it nobody can log in.
CONTROL_USER=approver
CONTROL_PASSWORD=change-me
# Name written into the notes and learning events ("approved by <name>"). Default: CONTROL_USER.
CONTROL_REVIEWER=
# Sent to n8n's decision webhook (header X-Control-Key); n8n must have the same value.
# Must differ from INTERNAL_API_KEY and APPROVER_KEY. The control room never holds APPROVER_KEY.
CONTROL_ROOM_KEY=change-me-to-a-long-random-value
# Same value as in 01-marketing-stack/.env: reschedule (19) and resume a pillar (61).
INTERNAL_API_KEY=change-me
# n8n inside the network (the webhook) and as your browser reaches it (the chat link).
N8N_BASE_URL=http://n8n:5678
N8N_PUBLIC_URL=http://localhost:5678/
# Services (defaults are the stack's container names).
CALENDAR_URL=http://content-calendar:8000
CAMPAIGNS_URL=http://campaign-service:8000
LEARNING_URL=http://learning-service:8000
ENGINE_URL=http://content-engine:8000
RULES_URL=http://platform-rules:8000
STATUS_URL=http://status-page:8000
CARDS_URL=http://image-cards:8000
VIDEO_URL=http://video-assembly:8000
# auto = Secure cookie when the request arrived over https (behind your HTTPS proxy); true / false.
COOKIE_SECURE=auto
SESSION_HOURS=12
SESSION_IDLE_MINUTES=120
UNDO_SECONDS=5
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15
