# Shared secret for POST /sync. Same value as in 01-marketing-stack/.env.
# Also sent as X-API-Key to analytics-ingest.
INTERNAL_API_KEY=change-me
# Self-hosted Umami: base URL plus login (or set UMAMI_API_KEY on Umami >= 3.4).
UMAMI_URL=https://umami.example.com
UMAMI_USERNAME=admin
UMAMI_PASSWORD=change-me
# Umami Cloud: leave UMAMI_URL empty (defaults to https://api.umami.is/v1) and set the key.
UMAMI_API_KEY=
# Website UUID from Umami -> Settings -> Websites.
UMAMI_WEBSITE_ID=
# Custom event counted as a conversion, e.g. umami.track('signup').
CONVERSION_EVENT=signup
# Time zone that defines a day.
UMAMI_TIMEZONE=UTC
# Pause before each Umami call (Umami Cloud allows 50 calls per 15 s).
UMAMI_PAUSE_SECONDS=0.35
ANALYTICS_URL=http://analytics-ingest:8000
