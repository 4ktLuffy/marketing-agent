# Path to the brand profile yaml inside the container.
BRAND_FILE=/config/brand.yaml
# Scoped fact store (v2). Its folder must be writable (the stack mounts a volume at /data).
FACTS_DB=/data/facts.sqlite
# A human's key for confirming/retiring/importing facts (X-Owner-Key). Unset = confirming is off.
FACT_OWNER_KEY=
