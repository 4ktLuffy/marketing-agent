# Shared secret for write endpoints (POST). Same value as in 01-marketing-stack/.env.
INTERNAL_API_KEY=change-me
# SQLite file; keep it on the /data volume.
DB_PATH=/data/engine.sqlite
# Ollama for the embedding novelty check (skipped, embedding_checked=false, when unreachable).
OLLAMA_URL=http://host.docker.internal:11434
EMBED_MODEL=qwen3-embedding:0.6b
# Thresholds (start values from _dev/research/content-volume.md; tune on real approvals).
MIN_ATOMS=12
NOVELTY_DAYS=90
NGRAM_MAX=0.30
EMBED_MAX=0.85
MIN_DECISIONS=10
REJECT_MAX=0.25
CLEAN_MIN=0.5
