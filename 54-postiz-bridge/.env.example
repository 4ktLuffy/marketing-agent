# Shared secret: /publish needs header X-API-Key with this value. Same value as in 01-marketing-stack/.env.
INTERNAL_API_KEY=change-me
# Postiz backend URL; /public/v1 is appended. Cloud: https://api.postiz.com
# Self-hosted: your NEXT_PUBLIC_BACKEND_URL, e.g. https://postiz.example.com/api
POSTIZ_URL=https://api.postiz.com
# Postiz: Settings -> Public API. Sent as "Authorization: <key>". Never logged or returned.
POSTIZ_API_KEY=
# Our channel -> Postiz integration id (ids from GET /integrations). Value may also be
# {"id":"...","settings":{...}} for providers that need extra settings (reddit, discord, ...).
CHANNEL_MAP={"linkedin":"<integration id>","x":"<integration id>"}
# true = validate only, never call Postiz. Set to false to really publish.
DRY_RUN=true
# Images from 17-image-cards: URLs under CARDS_PUBLIC_URL are downloaded from CARDS_URL instead
# (the public one is for browsers; the container reaches the service by its internal name).
CARDS_PUBLIC_URL=http://localhost:8117
CARDS_URL=http://image-cards:8000
# Videos from 71-video-assembly: URLs under VIDEO_PUBLIC_URL are downloaded from VIDEO_URL.
VIDEO_PUBLIC_URL=http://localhost:8171
VIDEO_URL=http://video-assembly:8000
# Largest video attached to a post (MB); a larger one is left off and the text still goes out.
MAX_VIDEO_MB=100
