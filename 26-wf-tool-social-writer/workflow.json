    {
      "id": "3beec490-ef60-5ae5-ba3d-f7d373c3fba2",
      "name": "Prepare",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "jsCode": "const KNOWN = ['x', 'linkedin', 'instagram', 'facebook', 'threads', 'mastodon'];\nconst ALIAS = { twitter: 'x', 'x/twitter': 'x', ig: 'instagram', insta: 'instagram', fb: 'facebook' };\nfunction normalizeChannels(raw) {\n  const list = String(raw || 'linkedin')\n    .split(/,|;|\\/| and |&/)\n    .map(c => c.trim().toLowerCase())\n    .map(c => ALIAS[c] || c)\n    .filter(c => KNOWN.includes(c));\n  const unique = [...new Set(list)];\n  if (!unique.length) throw new Error(`No supported channel in \"${raw}\". Use: ${KNOWN.join(', ')}`);\n  return unique;\n}\n\nconst s = $input.first().json;\nreturn [{ json: { topic: s.topic, channels: normalizeChannels(s.channels),\n  link: (s.link || '').trim(), campaign: (s.campaign || 'always-on').trim() } }];\n"
      }
    },
    {
      "id": "484111bf-3010-5ad3-9dd6-2550d4878d8a",
      "name": "Approved examples",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.LEARNING_URL }}/examples",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          }
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "k",
              "value": "3"
            }
          ]
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "f2b73cf4-7131-5359-86c4-7c11db6a8078",
      "name": "Write posts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.GATEWAY_URL }}/v1/run",
        "options": {
          "timeout": 300000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ prompt: 'social_posts', vars: { topic: $('Prepare').first().json.topic, channels: $('Prepare').first().json.channels.join(', '), link: $('Prepare').first().json.link || null, campaign: $('Prepare').first().json.campaign, examples: (Array.isArray($json.body) ? $json.body : []).filter(e => e && e.text).map(e => '- (' + e.channel + ') ' + e.text).join('\\n') || null } }) }}"
      }
    },
    {
      "id": "57679638-bf9a-5cc0-8b47-c6dbed357ebe",
      "name": "Split posts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        300
      ],
      "parameters": {
        "jsCode": "// Small models sometimes add channels nobody asked for, or drop the link. Fix both here,\n// deterministically, instead of trusting the model.\nconst p = $('Prepare').first().json;\nconst seen = new Set();\nconst out = [];\nfor (const post of $input.first().json.output.posts || []) {\n  const channel = String(post.channel || '').trim().toLowerCase();\n  if (!p.channels.includes(channel) || seen.has(channel)) continue;\n  seen.add(channel);\n  let text = String(post.text || '').trim();\n  if (p.link && !text.includes(p.link)) text += `\\n\\n${p.link}`;\n  out.push({ json: { channel, text } });\n}\nif (!out.length) throw new Error('The model returned no posts for the requested channels');\nreturn out;\n"
      }
    },
    {
      "id": "b93e9b71-9a22-5024-8c7a-d252d5c82949",
      "name": "UTM link",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.UTM_URL }}/build",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ url: $('Prepare').first().json.link || 'none', source: $json.channel, medium: 'social', campaign: $('Prepare').first().json.campaign }) }}"
      }
    },
    {
      "id": "8ebcc59e-0a06-5eef-86d3-d877c991382e",
      "name": "Apply UTM",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        300
      ],
      "parameters": {
        "jsCode": "const post = $('Split posts').item.json;\nconst p = $('Prepare').first().json;\nconst tagged = $json.url;  // utm-builder answer; absent when there is no link\nconst text = p.link && tagged ? post.text.split(p.link).join(tagged) : post.text;\nreturn { json: { channel: post.channel, text, link: tagged || p.link || null } };\n",
        "mode": "runOnceForEachItem"
      }
    },
    {
