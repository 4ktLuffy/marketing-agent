      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CALENDAR_URL }}/items",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.INTERNAL_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ title: ($('Prepare').first().json.topic + ' (' + $json.channel + ')').slice(0, 120), channel: $json.channel, body: $json.text, status: $json.ok ? 'in_review' : 'draft', campaign: $('Prepare').first().json.campaign, link: $('Prepare').first().json.link || null, notes: $json.problems.length ? 'Quality gate: ' + $json.problems.join('; ') : null }) }}"
      }
    },
    {
      "id": "96f6d8eb-4dd4-5796-82d3-823bed90917c",
      "name": "Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2160,
        300
      ],
      "parameters": {
        "jsCode": "const gate = $('Quality gate').all();\nconst parts = $input.all().map((saved, i) => {\n  const g = gate[i].json;\n  const s = saved.json;\n  const head = `### ${g.channel} — calendar #${s.id} (${s.status})`;\n  const notes = [];\n  if (g.rewritten) notes.push(`auto-fixed: ${g.fixed.join('; ')}`);\n  if (g.problems.length) notes.push(`needs a human: ${g.problems.join('; ')}`);\n  if (g.warnings.length) notes.push(`warnings: ${g.warnings.join('; ')}`);\n  return [head, g.text, notes.length ? `_${notes.join(' · ')}_` : ''].filter(Boolean).join('\\n\\n');\n});\nparts.push(\"Items marked in_review are waiting in the approval form; nothing is published until approved.\");\nreturn [{ json: { result: parts.join('\\n\\n') } }];\n"
      }
    }
